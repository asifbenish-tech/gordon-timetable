{
  "name": "reprise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:loom": "cross-env NAMES=loom vite build",
    "build:bot": "vite build --mode bot --outDir dist-bot",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "tsx tools/validate-content.ts",
    "placeholders": "tsx tools/make-placeholders.ts && tsx tools/make-normals.ts",
    "bot": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run validate && npm run test"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.3",
    "ajv": "8.17.1",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
